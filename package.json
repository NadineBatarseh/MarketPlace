{
  "name": "souqlink",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx --yes kill-port 4000",
    "dev": "concurrently -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/index.ts",
    "dev:client": "npx --yes wait-on -t 60000 tcp:4000 && vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@emailjs/browser": "^4.4.1",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@supabase/supabase-js": "^2.45.0",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.15.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.22.1",
    "groq-sdk": "^1.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "multer": "^2.1.1",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
